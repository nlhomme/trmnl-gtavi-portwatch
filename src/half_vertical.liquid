<div class="layout layout--col layout--stretch-x gap--space-between">
  <div class="flex flex--col flex--left gap--small w--full">
    <span class="label label--small label--gray">CLOSEST EFFORT TO PLAYABLE</span>
    <span class="value value--xxxlarge value--tnums">{{ score }}%</span>
    <span class="description">{{ leader_line }}</span>
  </div>
  <div class="grid grid--cols-2 gap w--full">
    {% render "stat", value: furthest_label, label: "Furthest milestone" %}
    {% render "stat", value: top3, suffix: "%", label: "Top-3 average" %}
    {% render "stat", value: boot_ratio, label: "Boot GTA VI" %}
    {% render "stat", value: tracked, label: "Efforts tracked" %}
  </div>
  <div class="flex flex--col flex--stretch-x gap--small w--full">
    {% render "bar", score: score, milestones: milestones %}
    <span class="label label--small">{{ next_line }}</span>
  </div>
</div>
<div class="title_bar">
  <span class="title">{{ trmnl.plugin_settings.instance_name }}</span>
  <span class="instance">{{ updated_line }}</span>
</div>
