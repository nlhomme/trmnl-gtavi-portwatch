<div class="layout layout--col layout--stretch-x gap--space-between">
  <div class="grid gap--large portrait:flex portrait:flex--col portrait:flex--stretch-x">
    <div class="col--span-5 flex flex--col flex--left gap--small">
      <span class="label label--small lg:label--base label--gray 1bit:text--black">OVERALL PROGRESS · CLOSEST EFFORT TO PLAYABLE</span>
      <span class="value value--xxlarge lg:value--xxxlarge value--tnums">{{ score }}%</span>
      <span class="description lg:description--xlarge">Leader: <b>{{ leader }}</b> has reached “{{ leader_reached_label }}”.</span>
    </div>
    <div class="col--span-7 grid grid--cols-2 gap">
      {% render "stat", value: furthest_label, label: "Furthest milestone" %}
      {% render "stat", value: top3, suffix: "%", label: "Top-3 average" %}
      {% render "stat", value: boot_ratio, label: "Boot GTA VI" %}
      {% render "stat", value: tracked, label: "Efforts tracked" %}
    </div>
  </div>

  <div class="flex flex--col flex--stretch-x w--full">
    {% render "markers", markers: markers %}
    {% render "bar", score: score, milestones: milestones %}
    {% render "milestone_labels", milestones: milestones %}
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ trmnl.plugin_settings.instance_name }}</span>
  <span class="instance">{{ updated_line }}</span>
</div>
