<div class="layout layout--col layout--stretch-x gap--space-between">
  <div class="flex flex--row flex--left gap w--full portrait:flex--col portrait:flex--left">
    <span class="value value--xlarge lg:value--xxxlarge value--tnums">{{ score }}%</span>
    <div class="flex flex--col flex--left gap--xsmall">
      <span class="label label--small lg:label--base">{{ leader_line }}</span>
      <span class="label label--small lg:label--base label--gray 1bit:text--black">Top-3 {{ top3 }}% · Boot {{ boot_ratio }}</span>
    </div>
  </div>
  <div class="flex flex--col flex--stretch-x gap--small w--full">
    {% render "bar", score: score, milestones: milestones %}
    <span class="label label--small lg:label--base">{{ next_line }}</span>
  </div>
</div>
<div class="title_bar">
  <span class="title">{{ trmnl.plugin_settings.instance_name }}</span>
  <span class="instance">{{ updated_line }}</span>
</div>
